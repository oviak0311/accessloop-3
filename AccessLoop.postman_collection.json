{
  "info": {
    "name": "AccessLoop API",
    "description": "Every AccessLoop endpoint. Set adminPasscode in the collection variables, then run 'Create a report' first: it saves reportId and editKey for the other requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminPasscode",
      "value": "choose-a-passcode"
    },
    {
      "key": "reportId",
      "value": "1"
    },
    {
      "key": "editKey",
      "value": ""
    },
    {
      "key": "originalReportId",
      "value": "7"
    }
  ],
