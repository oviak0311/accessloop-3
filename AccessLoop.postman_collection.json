    {
      "name": "Create and update",
      "item": [
        {
          "name": "Create a report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports"
              ]
            },
            "description": "Saves reportId and editKey into the collection variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"locationId\": 8,\n  \"severity\": \"medium\",\n  \"description\": \"Elevator won't come to the platform.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"reportId\", json.report.id);",
                  "pm.collectionVariables.set(\"editKey\", json.editKey);",
                  "console.log(\"Saved reportId\", json.report.id, \"and editKey\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a report at a stop from a route (no severity)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports"
              ]
            },
            "description": "Reports at a stop that AccessLoop may not have saved yet, the way the report pop-up does from a planned route. The server reuses a saved stop with the same name nearby, or adds the stop. With no severity, the barrier type sets it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 5,\n  \"place\": {\n    \"name\": \"The Gore Rd n/of Castlemore Rd\",\n    \"lat\": 43.79748,\n    \"lng\": -79.68372\n  },\n  \"description\": \"Snow bank between the curb and the bus door.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Filed under the stop\", () => pm.expect(pm.response.json().report.location.label).to.eql(\"The Gore Rd n/of Castlemore Rd\"));",
                  "pm.test(\"Severity came from the barrier type\", () => pm.expect(pm.response.json().report.severity).to.be.oneOf([\"LOW\", \"MEDIUM\", \"HIGH\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit my report (with edit key)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Edit-Key",
                "value": "{{editKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{reportId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"high\",\n  \"description\": \"Elevator won't come to the platform. Waited 10 minutes.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
