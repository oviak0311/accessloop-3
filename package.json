{
  "name": "accessloop",
  "version": "1.0.0",
  "description": "Report and track accessibility barriers on transit",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node --env-file=.env server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@prisma/client": "6.16.3",
    "express": "5.1.0"
  },
  "devDependencies": {
    "prisma": "6.16.3"
  },
  "allowScripts": {
    "prisma@6.16.3": true,
    "@prisma/engines@6.16.3": true,
    "@prisma/client@6.16.3": true
  }
}
