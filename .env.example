# Copy this file to .env and fill in your own values.
# Never commit .env to GitHub.

# Neon "pooled" connection string (the host contains "-pooler"). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/accessloop?sslmode=require"

# Neon "direct" connection string (same as above without "-pooler"). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/accessloop?sslmode=require"

# Passcode for the admin view. Choose your own.
ADMIN_PASSCODE="choose-a-passcode"

# Local port (optional)
PORT=3000

# Optional: contact sent to the Transitous trip planner (its usage policy asks for one)
# APP_CONTACT=https://github.com/oviak0311/accessloop

# Optional: a different Photon server for house-number address search (default: photon.komoot.io)
# PHOTON_URL=https://photon.komoot.io
